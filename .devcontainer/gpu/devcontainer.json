{
    "name": "gpu",
    "dockerFile": "../../Dockerfile",
    "runArgs": [
      "--gpus",
      "all",
      "--ipc=host"
    ],
    "customizations": {
      "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "redhat.vscode-yaml",
        "tamasfe.even-better-toml"
    ]
      }
    },
    "postCreateCommand": "git config --global --add safe.directory ${containerWorkspaceFolder}",
    "postStartCommand": "",
    "mounts": [
      "source=${localEnv:HOME}/.ssh,target=/root/.ssh,type=bind,consistency=cached"
    ]
  }
